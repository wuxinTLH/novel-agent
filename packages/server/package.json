{
  "name": "space.syjx.agent.novel.server",
  "version": "0.0.2-a",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node ../../build/packages/server/src/index.js",
    "start:dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-server-assets.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "admin": "tsx src/features/administration/admin.ts",
    "maintenance": "tsx src/features/administration/maintenance-cli.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "mssql": "^12.7.11",
    "multer": "^2.0.2",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "playwright": "^1.63.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/mssql": "^12.3.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2"
  }
}
