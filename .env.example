# Copy to .env only if it does not already exist. Loaded from the application root.
PORT=3001
# Exact case-sensitive key/values: local (default) or server. Invalid values fail startup.
# Native local mode binds 127.0.0.1 only; do not expose it via a remote reverse proxy.
# Docker/Compose default server; do not copy CoreModel=local into a server deployment .env.
# CoreModel=local
# server business startup forces hardened + audit, enabled auth, exact HTTPS origin,
# distinct >=32-character secret keys and disabled gateway. NOT a compliance certification.
# A completely fresh server DATA_DIR starts an isolated /init page before business startup.
# Optional owner token (>=32 random characters); unset generates private DATA_DIR/.init-token.
# Never commit the real token. Init reads Docker environment values, not the Docker socket.
# NOVEL_INIT_TOKEN=
# Bootstrap database choice only: nonempty environment values override Init form values.
# local-json (default) is active immediately; sql-later ONLY saves prospective v3 profiles.
# No connection, CREATE DATABASE, schema initialization, migration or SQL activation occurs.
# Later activation requires explicit offline maintenance; these variables do not override active storage.
# NOVEL_INIT_DB_MODE=local-json
# NOVEL_INIT_DB_DRIVER=postgresql
# NOVEL_INIT_DB_HOST=db.example.invalid
# NOVEL_INIT_DB_PORT=5432
# NOVEL_INIT_DB_DATABASE=novel_agent
# NOVEL_INIT_DB_USER=novel_agent
# NOVEL_INIT_DB_PASSWORD=
# NOVEL_INIT_DB_TLS=verify
# NOVEL_INIT_DB_TIMEOUT_MS=10000
# In server mode explicit SECURITY_PROFILE=standard / SECURITY_AUDIT=false are rejected.
# Optional additional hardening for local mode:
# SECURITY_PROFILE=hardened
# Optional metadata-only local audit in local standard mode; mandatory in server/hardened.
# SECURITY_AUDIT=true
# Default bundled Web hosting; set false for API-only deployment behind a same-origin proxy.
# SERVE_WEB=false
# Optional static build root (default dist), relative to the application root or absolute.
# WEB_DIST_DIR=dist
# A remote HTTPS proxy requires an explicit exact trusted origin; do not enable wildcard CORS.
# NOVEL_TRUSTED_PUBLIC_ORIGIN=https://novel.example.com
# MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4.1-mini
# MODEL_PROTOCOL=chat-completions
# Relative data paths resolve against the application root, not the launch directory.
# DATA_DIR=E:/novel-data
# Optional stable random key; otherwise a local model-secrets.key is created.
# MODEL_SECRETS_KEY=
# Optional stable random secret for encrypted platform session persistence.
# Without it, platform sessions remain in memory and require login after restart.
# Keep this key separate from public backups. Changing it cannot decrypt old sessions.
# PLATFORM_SECRETS_KEY=
# Fanqie supports isolated-browser login, verified account/work reads, draft upload/overwrite
# and submission for platform review. Configure explicit targets in the UI, not with tokens here.
# Automatic local approval never bypasses platform review, captcha or risk controls.
# See docs/使用手册.md and docs/番茄平台接入.md; never commit .env or real session data.
