# Copy to .env only if it does not already exist. Loaded from the application root.
PORT=3001
# Default bundled Web hosting; set false for API-only deployment behind a same-origin proxy.
# SERVE_WEB=false
# Optional static build root (default dist), relative to the application root or absolute.
# WEB_DIST_DIR=dist
# A remote HTTPS proxy requires an explicit exact trusted origin; do not enable wildcard CORS.
# NOVEL_TRUSTED_PUBLIC_ORIGIN=https://novel.example.com
# MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4.1-mini
# MODEL_PROTOCOL=chat-completions
# Relative data paths resolve against the application root, not the launch directory.
# DATA_DIR=E:/novel-data
# Optional stable random key; otherwise a local model-secrets.key is created.
# MODEL_SECRETS_KEY=
# Optional stable random secret for encrypted platform session persistence.
# Without it, platform sessions remain in memory and require login after restart.
# Keep this key separate from public backups. Changing it cannot decrypt old sessions.
# PLATFORM_SECRETS_KEY=
# Fanqie supports isolated-browser login, verified account/work reads, draft upload/overwrite
# and submission for platform review. Configure explicit targets in the UI, not with tokens here.
# Automatic local approval never bypasses platform review, captcha or risk controls.
# See docs/使用手册.md and docs/番茄平台接入.md; never commit .env or real session data.
