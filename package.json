{
  "name": "novel-agent",
  "version": "0.0.2-a",
  "private": true,
  "type": "module",
  "workspaces": ["packages/web", "packages/server"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm run dev --workspace space.syjx.agent.novel.server\" \"npm run dev --workspace space.syjx.agent.novel.web\"",
    "build": "npm run typecheck && npm run build --workspace space.syjx.agent.novel.web && npm run build --workspace space.syjx.agent.novel.server",
    "start": "npm run start --workspace space.syjx.agent.novel.server",
    "start:dev": "npm run start:dev --workspace space.syjx.agent.novel.server",
    "admin": "npm run admin --workspace space.syjx.agent.novel.server --",
    "maintenance": "npm run maintenance --workspace space.syjx.agent.novel.server --",
    "test:postgres": "tsx scripts/test-postgres-storage.ts",
    "browser:install": "playwright install chromium",
    "smoke": "node scripts/smoke.mjs",
    "smoke:auth": "node scripts/smoke-auth.mjs",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "concurrently": "^9.2.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.8",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "zod": "^4.1.5"
  }
}
